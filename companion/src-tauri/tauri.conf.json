{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eudaimonai",
  "version": "0.1.2",
  "identifier": "ai.eudonomia.companion",
  "build": {
    "frontendDist": "../webui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eudaimonai",
        "width": 1040,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundThrottling": "disabled",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:11434; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/clemenssteinbrennercrypto-prog/Eudaimonai/releases/download/internal-test/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOEIyMDhEQUQzQkFDQTIKUldTaXJEdXRqU0NML3lXZXlpTkhPcUpnSEFPQmZSWGx1cGpwRTl1WVJ3SzNLM0JMaktUYmsvOUQK"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/infoplist/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings",
      "resources/infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    },
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "resources/libmediapipe.dylib"
      ],
      "signingIdentity": null,
      "minimumSystemVersion": "11.0"
    }
  }
}
